<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Xmlang" Version="0.5.0" />
    <ProjectReference Include="..\MerEllerMindre.Domain\MerEllerMindre.Domain.csproj" />
    <ProjectReference Include="..\Blindbudet.Domain\Blindbudet.Domain.csproj" />
    <ProjectReference Include="..\TankTillTusen.Domain\TankTillTusen.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The xm spec pair is LOAD-BEARING at runtime (XmCatalog renders game screens from it).
         Copied beside the assembly so publish/Docker and the test host all find it under
         AppContext.BaseDirectory\specs. The spec never reaches the browser. -->
    <Content Include="..\..\specs\blindbudet.xm.yaml;..\..\specs\blindbudet.em.yaml;..\..\specs\tank-till-tusen.xm.yaml;..\..\specs\tank-till-tusen.em.yaml;..\..\specs\mer-eller-mindre.xm.yaml;..\..\specs\mer-eller-mindre.em.yaml"
             Link="specs\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
