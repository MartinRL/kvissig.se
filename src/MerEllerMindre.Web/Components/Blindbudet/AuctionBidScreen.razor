@* The Bid screen: the current lot is shown; the player places ONE hidden bid in the lott's
   own unit. No true worth / other bids appear here — those are revealed on the round-results
   screen. Interactive, so it does NOT poll: submitting swaps in the Waiting screen. *@
<div class="card">
    <div class="brand" style="margin-bottom:1rem">
        <span class="pill">Lott @Model.LotNumber / @Model.TotalLots · BlindBudet</span>
    </div>
    <h1>@Model.Description</h1>
    <p class="sub">Vad tror du den är värd? Ditt bud är hemligt tills alla har bjudit.</p>

    <form hx-post="@($"/blindbudet/{Model.JoinCode:N}/bid")" hx-target="#screen" hx-swap="innerHTML">
        <input type="hidden" name="__RequestVerificationToken" value="@Model.AntiforgeryToken" />

        <label>Ditt bud</label>
        <div class="bid-display">
            <span class="num empty" id="bidNum">0</span>
            <span class="unit">@Model.Unit</span>
        </div>
        <div class="keypad">
            <button type="button" class="key" data-k="7">7</button>
            <button type="button" class="key" data-k="8">8</button>
            <button type="button" class="key" data-k="9">9</button>
            <button type="button" class="key" data-k="4">4</button>
            <button type="button" class="key" data-k="5">5</button>
            <button type="button" class="key" data-k="6">6</button>
            <button type="button" class="key" data-k="1">1</button>
            <button type="button" class="key" data-k="2">2</button>
            <button type="button" class="key" data-k="3">3</button>
            <button type="button" class="key util" data-k=",">,</button>
            <button type="button" class="key" data-k="0">0</button>
            <button type="button" class="key util" data-k="del">⌫</button>
        </div>
        @* amount is posted invariant dot-decimal (AuctionEndpoints parses InvariantCulture);
           the display shows Swedish comma, this hidden field normalizes ,→. before submit. *@
        <input type="hidden" name="amount" id="bidAmount" value="" required />

        <button type="submit" class="btn" style="margin-top:1.5rem">Lägg bud!</button>
    </form>
</div>

<script>
    (function () {
        const numEl = document.getElementById('bidNum');
        const hidden = document.getElementById('bidAmount');
        let raw = '';
        function render() {
            numEl.textContent = raw === '' ? '0' : raw;
            numEl.classList.toggle('empty', raw === '');
            hidden.value = raw === '' ? '' : raw.replace(',', '.');
        }
        document.querySelectorAll('.keypad .key').forEach(key => {
            key.addEventListener('click', () => {
                const k = key.dataset.k;
                if (k === 'del') raw = raw.slice(0, -1);
                else if (k === ',') { if (!raw.includes(',')) raw = (raw === '' ? '0' : raw) + ','; }
                else raw = (raw === '0' ? '' : raw) + k;
                render();
            });
        });
        render();
    })();
</script>

@code {
    [Parameter] public required AuctionBidVm Model { get; set; }
}
