@* Round results: the lot is revealed — true worth, winner, price paid, and each player's bid,
   profit and running total. Polls every 2 s so non-host players auto-advance when the host taps
   "Nästa" (which fires the progression gear → next lot or the final standings). *@
<div hx-get="@StatePath" hx-trigger="every 2s" hx-target="#screen" hx-swap="innerHTML">
    <div class="card center">
        <span class="pill">Lott @Model.LotNumber / @Model.TotalLots</span>
        <h1 style="margin-top:1.1rem">@Model.Description</h1>
        <p class="answer">Sant värde: <span class="mer">@Model.TrueWorth @Model.Unit</span></p>
        <p class="sub">@WinnerLine</p>
    </div>

    <div class="card">
        <table class="scoreboard">
            <thead>
                <tr><th class="who">Spelare</th><th>Bud</th><th>Poäng</th><th class="total">Total</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr class="@(r.IsWinner ? "winner" : null)">
                        <td class="who">@r.Name@(r.IsHost ? " (värd)" : "")@(r.IsYou ? " · du" : "")</td>
                        <td>@r.Bid@(r.IsOverbid ? (MarkupString)" <span class=\"mark bad\">✗</span>" : (MarkupString)"")</td>
                        <td>@r.Profit</td>
                        <td class="total">@r.TotalSoFar</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.ViewerIsHost)
    {
        <form hx-post="@($"/blindbudet/{Model.JoinCode:N}/next")" hx-target="#screen" hx-swap="innerHTML">
            <input type="hidden" name="__RequestVerificationToken" value="@Model.AntiforgeryToken" />
            <button type="submit" class="btn">@(Model.HasNextLot ? "Nästa lott" : "Visa slutställning")</button>
        </form>
    }
    else
    {
        <p class="muted center">Väntar på att värden går vidare…</p>
    }
</div>

@code {
    [Parameter] public required AuctionRoundResultsVm Model { get; set; }
    private string StatePath => $"/blindbudet/{Model.JoinCode:N}/state";

    private string WinnerLine => Model.WinnerNames.Count switch
    {
        0 => "Ingen vann – alla bjöd över.",
        1 => $"{Model.WinnerNames[0]} vann med budet {Model.PricePaid} {Model.Unit}.",
        _ => $"{string.Join(" och ", Model.WinnerNames)} delade vinsten med budet {Model.PricePaid} {Model.Unit}."
    };
}
