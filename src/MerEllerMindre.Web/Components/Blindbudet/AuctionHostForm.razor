@* GET /blindbudet/new/{packId} — the host enters their name before the auction is created.
   Posting creates the auction (OpenAuction via POST /blindbudet) and the server HX-Redirects
   to the auction shell. Full page. *@
<MainLayout Title="BlindBudet: Skapa auktion">
    <div class="wrap">
        <div class="brand">
            <div class="logo"><span class="mer">Blind</span><span class="mindre">Budet</span></div>
            <span class="pill soft">Värd</span>
        </div>

        <div class="card">
            <h1>Skapa auktion</h1>
            <p class="sub">@Model.PackName</p>

            <form hx-post="/blindbudet" hx-swap="none">
                <input type="hidden" name="__RequestVerificationToken" value="@Model.AntiforgeryToken" />
                <input type="hidden" name="packId" value="@Model.PackId" />
                <label for="name">Ditt namn</label>
                <input type="text" id="name" name="hostName" placeholder="Skriv ditt namn" autofocus required />
                <button type="submit" class="btn">Skapa auktion</button>
            </form>
        </div>
    </div>
</MainLayout>

@code {
    [Parameter] public required AuctionHostFormVm Model { get; set; }
}
