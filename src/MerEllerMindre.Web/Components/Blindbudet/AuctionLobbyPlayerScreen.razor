@* Lobby as a joined player sees it: waiting for the host to start. Polls every 2 s so the
   first lot appears the moment the host starts. *@
<div hx-get="@StatePath" hx-trigger="every 2s" hx-target="#screen" hx-swap="innerHTML">
    <div class="card center">
        <h1>Du är med! 🎉</h1>
        <p class="sub">Väntar på att @Model.HostName startar auktionen…</p>
        <p class="busy">Inväntar start</p>
    </div>

    <div class="card">
        <div class="cardhead">Spelare <span class="pill">@Model.Players.Count med</span></div>
        <ul class="players">
            @foreach (var p in Model.Players)
            {
                <li>
                    <span class="dot"></span>
                    <span class="who">@p.Name@(p.IsHost ? " (värd)" : "")</span>
                    <span class="tag">@(p.IsYou ? "du" : "med")</span>
                </li>
            }
        </ul>
    </div>

    <div class="card">
        <div class="cardhead">Så funkar det</div>
        <ol class="steps">
            <li><strong>Lägg ett hemligt bud</strong> i varje budrunda: vad tror du det sanna värdet är?</li>
            <li><strong>Bjud inte över</strong>: det högsta budet som inte överstiger
                sant värde vinner (exakt rätt ger fulla poäng). Bjud du över får du 0.</li>
            <li><strong>Högst total vinner.</strong></li>
        </ol>
    </div>
</div>

@code {
    [Parameter] public required AuctionLobbyVm Model { get; set; }
    private string StatePath => $"/blindbudet/{Model.JoinCode:N}/state";
}
