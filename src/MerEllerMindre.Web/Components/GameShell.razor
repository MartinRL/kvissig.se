@* GET /games/{code} — the persistent shell every player keeps open. A single #screen div
   loads the current screen fragment from /state on load; each fragment then drives its own
   2 s poll (or, for the interactive Question screen, posts a guess). Full page. *@
<MainLayout Title="Mer eller Mindre">
    <div class="wrap">
        <div class="brand">
            <div class="logo"><span class="mer">Mer</span> eller <span class="mindre">Mindre</span></div>
            <span class="pill soft">kvissig.se</span>
        </div>

        <div id="screen" hx-get="@StatePath" hx-trigger="load" hx-target="#screen" hx-swap="innerHTML">
            <div class="card center"><p class="busy">Laddar…</p></div>
        </div>
    </div>
</MainLayout>

@code {
    [Parameter] public Guid JoinCode { get; set; }
    [Parameter] public bool ShowJoinUrl { get; set; }
    private string StatePath => $"/games/{JoinCode:N}/state{(ShowJoinUrl ? "?url" : "")}";
}
