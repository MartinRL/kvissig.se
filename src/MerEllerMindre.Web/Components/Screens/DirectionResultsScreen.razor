@* Mellansteget: stage 1 closed, the correct direction is revealed (and in logo mode the brand
   NAME too, now that the direction guess is locked) and the −10 bonus dealt. The drama screen
   between the two stages — it shows who called the direction right and the running total so far.
   Self-paced per player: tap "Fortsätt" to GET the stage-2 slider. Does NOT poll; the player
   advances themselves. *@
<div class="card center">
    <span class="pill">Fråga @Model.QuestionNumber / @Model.TotalQuestions · mer eller mindre avslöjat</span>
    <h1 style="margin-top:.6rem">@Model.QuestionText</h1>
    <p class="answer">@if (Model.MerLogo is not null) { <img class="logoimg" src="@Model.MerLogo" alt="@Model.MerItem" /> } <span class="mer">@Model.MerItem</span> är <span class="mer">MER</span> än @if (Model.MindreLogo is not null) { <img class="logoimg" src="@Model.MindreLogo" alt="@Model.MindreItem" /> } @Model.MindreItem</p>
</div>

<div class="card">
    <div class="cardhead">Mer eller Mindre <span class="pill soft">rätt ger −10</span></div>
    <table class="scoreboard">
        <thead>
            <tr><th>Spelare</th><th class="round">Gissning</th><th class="total">Total</th></tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td class="who">@r.Name@(r.IsHost ? " (värd)" : "")</td>
                    <td class="round" data-label="Gissning">@if (r.DirectionCorrect) { <span class="mark ok">✓</span> } else { <span class="mark bad">✗</span> } @(r.GuessedDirection == Direction.Mer ? "mer" : "mindre")</td>
                    <td class="total">@r.TotalSoFar</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<button class="btn" style="margin-top:1.75rem"
        hx-get="@($"/games/{Model.JoinCode:N}/difference")" hx-target="#screen" hx-swap="innerHTML">
    Fortsätt till skillnaden
</button>

@code {
    [Parameter] public required DirectionResultsVm Model { get; set; }
}
