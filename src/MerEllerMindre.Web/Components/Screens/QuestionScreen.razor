@* The Question screen, now a tvåstegsraket. Stage 1 (Direction): pick which item is MER —
   no slider. Stage 2 (Difference): the direction is already revealed, so the taller bar is
   FIXED; a slider in the card's OWN unit (0 → max(A,B)) answers the differensfråga. No raw
   values / facit appear here — those are revealed on the results screen. Interactive, so it
   does NOT poll: submitting swaps in the Waiting screen. *@
@if (Model.Stage == QuestionStage.Direction)
{
    <div class="card">
        <div class="brand" style="margin-bottom:1rem">
            <span class="pill">Fråga @Model.QuestionNumber / @Model.TotalQuestions · Mer eller Mindre</span>
        </div>
        <h1>@Model.QuestionText</h1>

        <form hx-post="@($"/games/{Model.JoinCode:N}/direction")" hx-target="#screen" hx-swap="innerHTML">
            <input type="hidden" name="__RequestVerificationToken" value="@Model.AntiforgeryToken" />
            <input type="hidden" name="direction" id="dirInput" value="Mer" />

            <p class="steplabel">Vilken är mer?</p>
            <div class="direction" role="group" aria-label="Mer eller Mindre">
                <button type="button" class="dirbtn" data-dir="Mer" aria-pressed="true">
                    <span class="arrow">▲</span>
                    @if (Model.LogoA is not null) { <img class="logoimg" src="@Model.LogoA" alt="Logotyp A" /> } else { @Model.ItemA }
                </button>
                <button type="button" class="dirbtn" data-dir="Mindre" aria-pressed="false">
                    <span class="arrow">▼</span>
                    @if (Model.LogoB is not null) { <img class="logoimg" src="@Model.LogoB" alt="Logotyp B" /> } else { @Model.ItemB }
                </button>
            </div>

            <button type="submit" class="btn" style="margin-top:1.75rem">Gissa!</button>
        </form>
    </div>

    <script>
        (function () {
            const dirInput = document.getElementById('dirInput');
            const buttons = document.querySelectorAll('.direction button');
            buttons.forEach(btn => btn.addEventListener('click', () => {
                buttons.forEach(b => {
                    const pressed = b === btn;
                    b.setAttribute('aria-pressed', pressed ? 'true' : 'false');
                    b.querySelector('.arrow').textContent = pressed ? '▲' : '▼';
                });
                dirInput.value = btn.dataset.dir;
            }));
        })();
    </script>
}
else
{
    <div class="card">
        <div class="brand" style="margin-bottom:1rem">
            <span class="pill">Fråga @Model.QuestionNumber / @Model.TotalQuestions · skillnad</span>
        </div>
        <h1>@Model.QuestionText</h1>
        <p class="answer">@if (MerLogo is not null) { <img class="logoimg" src="@MerLogo" alt="Logotyp" /> } else { <span class="mer">@MerItem</span> } är <span class="mer">MER</span> — hur stor är skillnaden?</p>

        <form hx-post="@($"/games/{Model.JoinCode:N}/difference")" hx-target="#screen" hx-swap="innerHTML">
            <input type="hidden" name="__RequestVerificationToken" value="@Model.AntiforgeryToken" />
            <input type="hidden" name="guessedDifference" id="diffInput" value="0" />

            <p class="steplabel">@Model.DifferencePrompt</p>
            @* ponytail: max stays in the DOM (max="5.9") — accepted view-source ceiling for a
               co-located party game; only the *displayed* value is hidden. Upgrade path if true
               hiding is ever needed: post a 0–100 proportion instead of the raw value. *@
            <div class="diffwrap">
                <input type="range" id="diff" min="0" max="@MaxStr" value="0" step="@StepStr" aria-label="@Model.Unit" />
            </div>

            <div class="twobars" aria-hidden="true">
                <div class="bar is-mer" id="barA" style="height:100%"></div>
                <div class="bar is-mindre" id="barB" style="height:100%"></div>
            </div>
            <div class="twobars-legend" aria-hidden="true">
                <span id="capA" data-label="A">@if (Model.LogoA is not null) { <img class="logoimg" src="@Model.LogoA" alt="Logotyp A" /> } else { @Model.ItemA }</span>
                <span id="capB" data-label="B">@if (Model.LogoB is not null) { <img class="logoimg" src="@Model.LogoB" alt="Logotyp B" /> } else { @Model.ItemB }</span>
            </div>

            <button type="submit" class="btn" style="margin-top:1.75rem">Gissa!</button>
        </form>
    </div>

    <script>
        (function () {
            const max = @MaxStr;
            const merIsA = @(MerIsA ? "true" : "false");
            const range = document.getElementById('diff');
            const diffInput = document.getElementById('diffInput');
            const barA = document.getElementById('barA');
            const barB = document.getElementById('barB');
            const capA = document.getElementById('capA');
            const capB = document.getElementById('capB');
            // In logo mode the captions hold an <img>, not a name: read the text but fall back on
            // the neutral data-label ("A"/"B") so screen-reader output never leaks a hidden name.
            const logoMode = !!capA.querySelector('img');
            const nameA = capA.textContent.trim() || capA.dataset.label;
            const nameB = capB.textContent.trim() || capB.dataset.label;
            const tallName = merIsA ? nameA : nameB;
            const shortName = merIsA ? nameB : nameA;

            function norm(v) { return max > 0 ? Math.min(100, Math.round(v / max * 100)) : 0; }

            // Direction is locked in stage 2: the taller (MER) bar never moves.
            const tall = merIsA ? barA : barB;
            const short = merIsA ? barB : barA;
            const shortCap = merIsA ? capB : capA;   // only the short bar's caption shows the live %
            tall.classList.add('is-mer'); tall.classList.remove('is-mindre');
            short.classList.add('is-mindre'); short.classList.remove('is-mer');
            tall.style.height = '100%';

            function render() {
                const v = Number(range.value);
                diffInput.value = range.value;
                const n = norm(v);
                range.style.background = `linear-gradient(90deg, var(--accent) ${n}%, var(--line) ${n}%)`;
                const pct = 100 - n;
                short.style.height = pct + '%';
                // Keep the logo intact in logo mode (writing textContent would wipe the <img>).
                if (!logoMode) shortCap.textContent = `${shortName} ≈ ${pct}%`;
                range.setAttribute('aria-valuetext', `${shortName} ${pct} procent av ${tallName}`);
            }

            range.addEventListener('input', render);
            render();
        })();
    </script>
}

@code {
    [Parameter] public required QuestionVm Model { get; set; }
    private string MaxStr => Model.SliderMax.ToString(CultureInfo.InvariantCulture);
    private string StepStr => Model.SliderStep.ToString(CultureInfo.InvariantCulture);
    private bool MerIsA => Model.RevealedDirection == Direction.Mer;
    private string MerItem => MerIsA ? Model.ItemA : Model.ItemB;
    private string? MerLogo => MerIsA ? Model.LogoA : Model.LogoB;
}
