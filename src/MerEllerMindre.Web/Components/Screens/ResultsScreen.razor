@* Round results: the answer is revealed here (and ONLY here) — the larger item is MER, the
   raw values on the two-bars, the normalized difference, and the per-player scoreboard (lowest
   total leads). Polls every 2 s so everyone follows when the host advances; the host gets the
   Next/End button that fires the progression gear. *@
<div hx-get="@StatePath" hx-trigger="every 2s" hx-target="#screen" hx-swap="innerHTML">
    <div class="card center">
        <span class="pill">Fråga @Model.QuestionNumber / @Model.TotalQuestions · resultat</span>
        <h1 style="margin-top:.6rem">@Model.QuestionText</h1>
        <p class="answer"><span class="mer">@Model.LargerItem</span> är <span class="mer">MER</span></p>

        <div class="twobars" aria-hidden="true">
            <div class="bar a" style="height:100%"><span>@Fmt(Model.LargerValue)</span><span class="barcap">@Model.LargerItem · @Fmt(Model.LargerValue) @Model.Unit</span></div>
            <div class="bar b" style="height:@Model.SmallerBarPercent%"><span>@Fmt(Model.SmallerValue)</span><span class="barcap">@Model.SmallerItem · @Fmt(Model.SmallerValue) @Model.Unit</span></div>
        </div>

        <p style="margin-top:2.2rem">Normaliserad skillnad <span class="diffnum">@Model.CorrectDifference</span> / 100</p>
    </div>

    <div class="card">
        <div class="cardhead">Poäng <span class="pill soft">lägst total leder</span></div>
        <table class="scoreboard">
            <thead>
                <tr><th class="rank">#</th><th>Spelare</th><th class="round">Gissning</th><th class="round">Rond</th><th class="total">Total</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td class="rank">@r.Rank</td>
                        <td class="who">@r.Name@(r.IsHost ? " (värd)" : "") @if (r.IsYou) { <small class="muted">(du)</small> }</td>
                        <td class="round">@(r.GuessedDirection == Direction.Mer ? "mer" : "mindre"), @r.GuessedDifferenceNormalized</td>
                        <td class="round">@Signed(r.RoundScore)</td>
                        <td class="total">@r.TotalScore</td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="muted" style="margin-top:.8rem">Rätt riktning ger −10 bonus; differenspoäng = |gissad − @Model.CorrectDifference|.</p>
    </div>

    @if (Model.ViewerIsHost)
    {
        <form hx-post="@($"/games/{Model.JoinCode:N}/next")" hx-target="#screen" hx-swap="innerHTML">
            <input type="hidden" name="__RequestVerificationToken" value="@Model.AntiforgeryToken" />
            <button type="submit" class="btn">@(Model.HasNextQuestion ? "Nästa fråga" : "Visa slutställning")</button>
        </form>
    }
    else
    {
        <p class="fakenav next-hint">Spelledaren går vidare strax…</p>
    }
</div>

@code {
    [Parameter] public required ResultsVm Model { get; set; }
    private string StatePath => $"/games/{Model.JoinCode:N}/state";
    private static string Fmt(decimal d) => d.ToString("0.##", CultureInfo.InvariantCulture);
    private static string Signed(int n) => n > 0 ? $"+{n}" : n.ToString(CultureInfo.InvariantCulture);
}
