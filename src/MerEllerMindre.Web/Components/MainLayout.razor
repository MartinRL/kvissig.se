@* Shared full-page shell for static-SSR screens. Full-page components (QuizCatalog,
   GameLobby) wrap their markup in <MainLayout>…</MainLayout>; fragment components
   (PlayersList, OpenLobbyForm) render bare markup and do NOT use this. Google Fonts arrive
   via playful.css's own @@import. *@
@inject IHttpContextAccessor Http
<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Title</title>
    <meta name="description" content="@Description" />
    <link rel="canonical" href="@Canonical" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mer eller Mindre" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:title" content="@Title" />
    <meta property="og:description" content="@Description" />
    <meta property="og:url" content="@Canonical" />
    <meta property="og:image" content="@AbsoluteOgImage" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@Title" />
    <meta name="twitter:description" content="@Description" />
    <meta name="twitter:image" content="@AbsoluteOgImage" />
    <link rel="icon" href="/icon.svg?v=2" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#21c08a" />
    <link rel="stylesheet" href="/css/playful.css" />
    <script src="/js/htmx.min.js" defer></script>
    <!-- Privacy-friendly analytics by Plausible -->
    <script async src="https://plausible.io/js/pa--JBgPld5gC_xUVqxHwmSh.js"></script>
    <script>
        window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
        plausible.init()
    </script>
    <script type="application/ld+json">
    {"@@context":"https://schema.org","@@graph":[
      {"@@type":"WebSite","name":"Mer eller Mindre","url":"@SiteUrl","inLanguage":"sv"},
      {"@@type":"Organization","name":"Mer eller Mindre","url":"@SiteUrl","logo":"@SiteUrl/icons/icon-512.png"}
    ]}
    </script>
    @if (JsonLd is not null)
    {
        @((MarkupString)$"<script type=\"application/ld+json\">{JsonLd}</script>")
    }
</head>
<body>
    <div id="error-banner" class="error-banner" hidden></div>
    @if (ShowMenu)
    {
        <input type="checkbox" id="navtoggle" class="navtoggle" hidden />
        <label for="navtoggle" class="hamburger" aria-label="Meny" title="Meny">
            <span></span><span></span><span></span>
        </label>
        <nav class="mainnav">
            <a href="/">Kviss</a>
            <a href="/om-spelet">Om spelet</a>
            <a href="/om-spelet#sa-spelar-du">Så spelar du</a>
            <a href="/om-mig">Om mig</a>
        </nav>
    }
    @ChildContent
    <script>
        document.body.addEventListener('htmx:responseError', e => {
            const b = document.getElementById('error-banner');
            b.textContent = e.detail.xhr.responseText || 'Något gick fel.';
            b.hidden = false;
        });
        document.body.addEventListener('click', async e => {
            const b = e.target.closest('.share-btn'); if (!b) return;
            const data = { title: b.dataset.shareTitle, text: b.dataset.shareText, url: location.origin };
            try { if (navigator.share) { await navigator.share(data); return; } } catch { return; }
            try { await navigator.clipboard.writeText(location.origin); b.classList.add('copied'); } catch {}
        });
        if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js');
    </script>
</body>
</html>

@code {
    [Parameter] public string Title { get; set; } = "Mer eller Mindre";
    [Parameter] public string Description { get; set; } =
        "Gissa mer eller mindre, och sedan hur stor skillnaden är. Mer eller Mindre (eng. More or Less) är frågespelet ni spelar online men tillsammans i samma rum, var och en på sin skärm.";
    [Parameter] public string CanonicalPath { get; set; } = "/";
    [Parameter] public string OgImage { get; set; } = "/screenshots/screenshot-1280x720.png";
    [Parameter] public bool ShowMenu { get; set; } = true;
    // Optional per-page schema.org JSON-LD (already-serialized object, no enclosing <script>).
    [Parameter] public string? JsonLd { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    // Built from the request host so canonical/OG URLs are absolute and match the live origin
    // (behind fly's edge, ForwardedHeaders makes Scheme=https + the public Host).
    private string SiteUrl
    {
        get
        {
            var req = Http.HttpContext!.Request;
            return $"{req.Scheme}://{req.Host}";
        }
    }
    private string Canonical => $"{SiteUrl}{CanonicalPath}";
    private string AbsoluteOgImage => OgImage.StartsWith("http") ? OgImage : $"{SiteUrl}{OgImage}";
}
