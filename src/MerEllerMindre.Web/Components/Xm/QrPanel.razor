@* The scannable join QR + optional plain-text join URL with copy button.
   Markup verbatim from the hand-written lobby screen. *@
<div class="qr">@((MarkupString)Model.Svg)</div>
@if (Model.ShowUrl)
{
    <p class="joinlink muted">
        …eller gå till
        <a href="@Model.JoinUrl">@Model.JoinUrl</a>
        <button type="button" class="copybtn" title="Kopiera länk"
                onclick="navigator.clipboard.writeText('@Model.JoinUrl').then(() => { this.classList.add('copied'); setTimeout(() => this.classList.remove('copied'), 1200); })">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="9" y="9" width="13" height="13" rx="2"/>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
            <span class="sr-only">Kopiera länk</span>
        </button>
    </p>
}

@code {
    [Parameter] public required QrField Model { get; set; }
}
