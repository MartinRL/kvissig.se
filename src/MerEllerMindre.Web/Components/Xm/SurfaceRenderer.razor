@* The xm interpreter engine: renders one XmScreenModel. The xm surface owns composition
   ORDER and salience TIERS; the FieldBag owns presence; playful.css idioms come from the
   Field records themselves. Layout: header card (secondary pills, heading, sub, primary
   inline fields) → block-field cards → on-demand <details> → command forms → footer.
   GAME-AGNOSTIC BY CONTRACT: no game name, route or copy may ever appear here. *@
<div @attributes="WrapperAttrs">
    <div class="card center">
        @foreach (var pill in Tier(v => v.Secondary).OfType<TextField>())
        {
            <FieldBlock Field="pill" />
        }
        @if (Model.Heading is not null)
        {
            <h1 style="@(HasPills ? "margin-top:1.1rem" : null)">@Model.Heading</h1>
        }
        @if (Model.Sub is not null)
        {
            <p class="sub">@Model.Sub</p>
        }
        @foreach (var field in Tier(v => v.Primary).Where(Inline))
        {
            <FieldBlock Field="field" />
        }
        @Region("header")
        @if (Model.Source is not null)
        {
            <details class="source">
                <summary>Källa</summary>
                <div class="muted">@((MarkupString)Linkified(Model.Source))</div>
            </details>
        }
    </div>

    @foreach (var field in Tier(v => v.Primary).Concat(Tier(v => v.Secondary)).Where(f => !Inline(f)))
    {
        <FieldBlock Field="field" />
    }
    @Region("body")

    @if (Model.Steps is not null)
    {
        <FieldBlock Field="Model.Steps" />
    }

    @if (Tier(v => v.OnDemand).Any())
    {
        <details class="ondemand">
            <summary>Mer</summary>
            @foreach (var field in Tier(v => v.OnDemand))
            {
                <FieldBlock Field="field" />
            }
        </details>
    }

    @foreach (var command in Model.Commands.Where(c => SlotOf(c.Name) is null or "footer"))
    {
        <ActionForm Model="command" Token="@Model.Token" />
    }
    @Region("footer")

    @if (Model.Footer is not null)
    {
        <p class="muted center">@Model.Footer</p>
    }

    @if (Model.PlayAgainHref is not null)
    {
        <a class="btn" style="margin-bottom:1.1rem" href="@Model.PlayAgainHref">Spela igen</a>
    }
    @if (Model.ShareText is not null)
    {
        <div class="card center">
            <p class="steplabel">Gillade ni spelet?</p>
            <p class="muted">Dela det med familj och vänner så får de samma fina upplevelse.</p>
            <ShareButton Text="@Model.ShareText" />
        </div>
    }
</div>

@code {
    [Parameter] public required XmScreenModel Model { get; set; }

    private Dictionary<string, object>? WrapperAttrs => Model.PollPath is null ? null : new()
    {
        ["hx-get"] = Model.PollPath,
        ["hx-trigger"] = "every 2s",
        ["hx-target"] = "#screen",
        ["hx-swap"] = "innerHTML",
    };

    /// <summary>Walk the surface's UNSLOTTED composed views in xm order, yielding the tier's
    /// fields that the materializer put in the bag (the presence contract). Slotted items
    /// (xmlang v0.3-experimental) render wholesale in their region instead.</summary>
    private IEnumerable<Field> Tier(Func<Xmlang.XmViewItem, IReadOnlyList<string>> tier) =>
        Model.Surface.Compose
            .Where(item => item.Slot is null)
            .Select(item => item.View)
            .Where(view => view is not null)
            .SelectMany(view => tier(view!))
            .Select(name => Model.Fields.GetValueOrDefault(name))
            .OfType<Field>();

    /// <summary>One region's slotted items, in compose order: a view item's primary+secondary
    /// fields as blocks, its on-demand fields behind a disclosure (salience is orthogonal to
    /// region), a command item's form. Footer commands render in the default command loop
    /// (footer IS the default command region).</summary>
    private RenderFragment<string> Region => slot => @<text>
        @foreach (var item in Model.Surface.Compose.Where(i => i.Slot == slot))
        {
            @if (item.View is { } view)
            {
                foreach (var f in ItemFields(view, v => v.Primary).Concat(ItemFields(view, v => v.Secondary)))
                {
                    <FieldBlock Field="f" />
                }
                @if (ItemFields(view, v => v.OnDemand).Any())
                {
                    <details class="ondemand">
                        <summary>Mer</summary>
                        @foreach (var f in ItemFields(view, v => v.OnDemand))
                        {
                            <FieldBlock Field="f" />
                        }
                    </details>
                }
            }
            @if (item.Command is { } c && slot != "footer" && Model.Commands.FirstOrDefault(m => m.Name == c.Name) is { } command)
            {
                <ActionForm Model="command" Token="@Model.Token" />
            }
        }
    </text>;

    private IEnumerable<Field> ItemFields(Xmlang.XmViewItem view, Func<Xmlang.XmViewItem, IReadOnlyList<string>> tier) =>
        tier(view).Select(name => Model.Fields.GetValueOrDefault(name)).OfType<Field>();

    private string? SlotOf(string command) =>
        Model.Surface.Compose.FirstOrDefault(i => i.Command?.Name == command)?.Slot;

    /// <summary>Inline fields live in the header card; block fields get their own card.</summary>
    private static bool Inline(Field field) => field is TextField or QrField or BarsField;

    private bool HasPills => Tier(v => v.Secondary).OfType<TextField>().Any();

    private static readonly System.Text.RegularExpressions.Regex UrlRe =
        new(@"https?://\S+", System.Text.RegularExpressions.RegexOptions.Compiled);

    // HTML-encode the whole citation first (boundary hygiene even though pack data is trusted),
    // then turn well-formed http(s) URLs into links. Bare domains (arla.com) stay plain text.
    private static string Linkified(string source)
    {
        var encoded = System.Net.WebUtility.HtmlEncode(source);
        return UrlRe.Replace(encoded, m =>
            $"<a href=\"{m.Value}\" target=\"_blank\" rel=\"noopener\">{m.Value}</a>");
    }
}
