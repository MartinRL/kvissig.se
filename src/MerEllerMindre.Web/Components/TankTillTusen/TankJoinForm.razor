@* GET /tank-till-tusen/{code}/join — a player enters their name. Posting joins the game
   (JoinGame) and the server HX-Redirects to the game shell. Full page. *@
<MainLayout Title="Tänk Till Tusen: Gå med">
    <div class="wrap">
        <div class="brand">
            <div class="logo"><span class="mer">Tänk Till</span> <span class="mindre">Tusen</span></div>
            <span class="pill soft">Gå med</span>
        </div>

        <div class="card">
            <h1>Gå med i spelet</h1>
            <p class="sub">@Model.HostName (värd)</p>

            <form hx-post="@($"/tank-till-tusen/{Model.JoinCode:N}/join")" hx-swap="none">
                <input type="hidden" name="__RequestVerificationToken" value="@Model.AntiforgeryToken" />
                <label for="name">Ditt namn</label>
                <input type="text" id="name" name="playerName" placeholder="Skriv ditt namn" autofocus required />
                <button type="submit" class="btn">Gå med</button>
            </form>
        </div>
    </div>
</MainLayout>

@code {
    [Parameter] public required TankJoinFormVm Model { get; set; }
}
