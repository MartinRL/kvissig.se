@* GET /tank-till-tusen/om-spelet — the crawlable/citeable "About" page for Tänk Till Tusen.
   Plain static SSR, no JS. Frågerubriker + korta definitionssvar (GEO). Section "Historien
   bakom" is the owner's text. FAQ here MUST stay in sync with the FAQPage JSON-LD in @code
   (FaqJsonLd). *@
<MainLayout Title="Om Tänk Till Tusen: sifferspelet online men tillsammans"
            Description="Tänk Till Tusen är ett svenskt sifferspel online men tillsammans i samma rum: alla får samma sex tal och samma mål, och kappas mot klockan om att nå det med de fyra räknesätten. Närmast vinner rundan, lägst total vinner."
            CanonicalPath="/tank-till-tusen/om-spelet"
            JsonLd="@FaqJsonLd">
    <div class="wrap content">
        <div class="brand">
            <a class="logo" href="/tank-till-tusen"><span class="mer">Tänk Till</span> <span class="mindre">Tusen</span></a>
        </div>

        @* 1. Hero / pitch *@
        <h1>Sifferspelet: sex tal, ett mål, en minut</h1>
        <p class="sub">
            <strong>Tänk Till Tusen</strong> är ett svenskt sifferspel där alla får samma sex
            tal och samma mål. Nå målet med de fyra räknesätten innan tiden är ute: närmast
            (eller exakt) vinner rundan, och lägst total vinner spelet. Samla gänget runt
            bordet, en skärm var, och räkna ikapp.
        </p>
        <a class="btn" href="/tank-till-tusen">Välj nivå och spela</a>

        @* 2. Vad är det? *@
        <div class="card">
            <h2>Vad är Tänk Till Tusen?</h2>
            <p>
                Tänk Till Tusen är ett digitalt sifferspel för 2 eller fler spelare. Alla får
                samma sex tal och samma mål. Med de fyra räknesätten (plus, minus, gånger,
                delat) bygger var och en sin väg mot målet på @CountdownSeconds sekunder.
                Den som kommer närmast vinner rundan, exakt träff ger bonus, och efter
                @RoundCount pussel vinner den med lägst total.
            </p>
        </div>

        @* 3. Så spelar du *@
        <div class="card" id="sa-spelar-du">
            <h2>Så spelar du</h2>
            <ol class="steps">
                <li><strong>Välj nivå.</strong> Familj, Klassisk eller Svår. Du blir värd och
                    första spelaren.</li>
                <li><strong>Samlas.</strong> Värden visar en QR-kod, övriga skannar och ansluter
                    med var sin skärm.</li>
                <li><strong>Räkna.</strong> Varje pussel ger sex tal och ett mål. Kombinera
                    talen med de fyra räknesätten och lås ditt bästa svar innan minuten är ute.</li>
                <li><strong>Lägst vinner.</strong> Avståndet till målet blir dina poäng, exakt
                    träff ger minuspoäng i bonus. Efter @RoundCount pussel vinner den
                    med lägst total.</li>
            </ol>
        </div>

        @* 4. Nivåerna *@
        <div class="card">
            <h2>Nivåerna</h2>
            <ul class="bullets">
                <li><strong>Familj:</strong> lite lättare, målet går alltid att nå på två
                    räknesteg.</li>
                <li><strong>Klassisk:</strong> originalet, blandad svårighet.</li>
                <li><strong>Svår:</strong> för räknerävar, målet kräver minst fyra räknesteg.</li>
            </ul>
        </div>

        @* 5. Historien bakom — ÄGARENS TEXT. *@
        <div class="card">
            <h2>Historien bakom</h2>
            <p>
                Tänk till tusen gick i SVT 1984 till 1987, med Ulf Wickbom som programledare
                och den franska långköraren <em>Des chiffres et des lettres</em> som förlaga.
                Två tävlande möttes i två omväxlande grenar: bygga längsta ordet av slumpade
                bokstäver, och nå ett givet tal med de fyra räknesätten.
            </p>
            <p>
                Jag såg det på teve som tonåring i högstadiet. Vår mattelärare brukade låta
                oss spela det som en kul avslutning på veckan under fredagslektionen, och
                inte sällan vann jag. Älskade spelet!
            </p>
            <p>
                Sedan dess har jag inte spelat det. Men när jag ändå hade kvissig.se-plattformen
                var det på tiden att göra en version här: sifferdelen, den jag älskade mest,
                online men tillsammans i samma rum.
            </p>
        </div>

        @* 6. FAQ (matchar FaqJsonLd nedan) *@
        <div class="card">
            <h2>Frågor &amp; svar</h2>

            <h3>Måste vi sitta i samma rum?</h3>
            <p>Spelet är gjort för det: en skärm var, alla i samma rum. Det fungerar tekniskt
               på distans också (t.ex. över videosamtal), men det är roligast tillsammans.</p>

            <h3>Behöver man installera en app?</h3>
            <p>Nej. Det spelas direkt i webbläsaren. Den som är värd öppnar ett spel och delar
               koden eller QR-koden.</p>

            <h3>Hur många kan spela?</h3>
            <p>Från 2 spelare och uppåt. Varje deltagare använder sin egen skärm.</p>

            <h3>Hur räknas poängen?</h3>
            <p>Ditt avstånd till målet blir dina poäng för rundan (max 100). Exakt träff ger
               minus 10. Inget svar ger 100. Lägst total efter @RoundCount pussel
               vinner.</p>

            <h3>Måste man vara bra på huvudräkning?</h3>
            <p>Nej. Nivån Familj är byggd så att målet alltid går att nå på två räknesteg, och
               även ett ungefärligt svar ger poäng. Det räcker att komma nära.</p>
        </div>

        <a class="btn" href="/tank-till-tusen">Välj nivå och spela</a>
        <a class="back" href="/tank-till-tusen">← Tillbaka</a>
    </div>
</MainLayout>

@code {
    // FAQPage + Game schema for rich results / LLM citation. Keep the Q&A in sync with the
    // FAQ section above. Serialized object only (MainLayout wraps it in <script>).
    private const string FaqJsonLd = """
    {"@context":"https://schema.org","@graph":[
      {"@type":"Game","name":"Tänk Till Tusen","description":"Svenskt sifferspel online men tillsammans i samma rum: alla får samma sex tal och samma mål, och kappas mot klockan om att nå det med de fyra räknesätten. Närmast vinner rundan, lägst total vinner.","genre":"Sifferspel","inLanguage":"sv","gamePlatform":"Webbläsare","numberOfPlayers":{"@type":"QuantitativeValue","minValue":2}},
      {"@type":"FAQPage","mainEntity":[
        {"@type":"Question","name":"Måste vi sitta i samma rum?","acceptedAnswer":{"@type":"Answer","text":"Spelet är gjort för det: en skärm var, alla i samma rum. Det fungerar tekniskt på distans också, men det är roligast tillsammans."}},
        {"@type":"Question","name":"Behöver man installera en app?","acceptedAnswer":{"@type":"Answer","text":"Nej. Det spelas direkt i webbläsaren. Den som är värd öppnar ett spel och delar koden eller QR-koden."}},
        {"@type":"Question","name":"Hur många kan spela?","acceptedAnswer":{"@type":"Answer","text":"Från 2 spelare och uppåt. Varje deltagare använder sin egen skärm."}},
        {"@type":"Question","name":"Hur räknas poängen?","acceptedAnswer":{"@type":"Answer","text":"Ditt avstånd till målet blir dina poäng för rundan (max 100). Exakt träff ger minus 10. Inget svar ger 100. Lägst total efter fem pussel vinner."}},
        {"@type":"Question","name":"Måste man vara bra på huvudräkning?","acceptedAnswer":{"@type":"Answer","text":"Nej. Nivån Familj är byggd så att målet alltid går att nå på två räknesteg, och även ett ungefärligt svar ger poäng. Det räcker att komma nära."}}
      ]}
    ]}
    """;

    private static int RoundCount => global::TankTillTusen.Domain.Decider.RoundCount;
    private static int CountdownSeconds => global::TankTillTusen.Domain.Decider.CountdownSeconds;
}
