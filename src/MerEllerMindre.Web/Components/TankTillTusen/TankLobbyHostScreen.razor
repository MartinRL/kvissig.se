@* Lobby as the host sees it: the QR to share, the live player list, and the Start button
   (enabled at 2+ players). Polls every 2 s to pick up joiners and the start. *@
<div hx-get="@StatePath" hx-trigger="every 2s" hx-target="#screen" hx-swap="innerHTML">
    <div class="card center">
        <h1>Skanna för att gå med</h1>
        <p class="sub">Övriga spelare går med genom att skanna QR-koden.</p>
        <div class="qr">@((MarkupString)Model.QrSvg)</div>
        @if (Model.ShowJoinUrl)
        {
            <p class="joinlink muted">
                …eller gå till
                <a href="@Model.JoinUrl">@Model.JoinUrl</a>
                <button type="button" class="copybtn" title="Kopiera länk"
                        onclick="navigator.clipboard.writeText('@Model.JoinUrl').then(() => { this.classList.add('copied'); setTimeout(() => this.classList.remove('copied'), 1200); })">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="9" y="9" width="13" height="13" rx="2"/>
                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                    </svg>
                    <span class="sr-only">Kopiera länk</span>
                </button>
            </p>
        }
    </div>

    <div class="card">
        <div class="cardhead">Spelare <span class="pill">@Model.Players.Count med</span></div>
        <ul class="players">
            @foreach (var p in Model.Players)
            {
                <li>
                    <span class="dot"></span>
                    <span class="who">@p.Name@(p.IsHost ? " (värd)" : "")</span>
                    <span class="tag">@(p.IsYou ? "du" : "med")</span>
                </li>
            }
        </ul>
    </div>

    <div class="card">
        <div class="cardhead">Så funkar det</div>
        <ol class="steps">
            <li><strong>Alla får samma sex tal</strong> och samma mål när tiden startar.</li>
            <li><strong>Nå målet</strong> med de fyra räknesätten: kombinera två tal i taget till ett nytt.
                Pricka målet exakt så får du 0 poäng. Ju längre ifrån, desto fler poäng (upp till 100).</li>
            <li><strong>Lägst total vinner.</strong></li>
        </ol>
    </div>

    @if (Model.CanStart)
    {
        <form hx-post="@($"/tank-till-tusen/{Model.JoinCode:N}/start")" hx-target="#screen" hx-swap="innerHTML">
            <input type="hidden" name="__RequestVerificationToken" value="@Model.AntiforgeryToken" />
            <button type="submit" class="btn">Starta spel</button>
        </form>
    }
    else
    {
        <p class="muted center">Behöver minst 2 spelare · @Model.Players.Count ansluten(a)</p>
    }
</div>

@code {
    [Parameter] public required TankLobbyVm Model { get; set; }
    private string StatePath => $"/tank-till-tusen/{Model.JoinCode:N}/state{(Model.ShowJoinUrl ? "?url" : "")}";
}
