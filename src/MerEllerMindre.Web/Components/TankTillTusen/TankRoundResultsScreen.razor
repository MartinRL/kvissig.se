@* Round results: the puzzle is revealed — the target, a sample solution, and each player's
   reached value, round score and running total (lowest first). Polls every 2 s so non-host
   players auto-advance when the host taps "Nästa" (progression gear → next puzzle or standings). *@
<div hx-get="@StatePath" hx-trigger="every 2s" hx-target="#screen" hx-swap="innerHTML">
    <div class="card center">
        <span class="pill">Pussel @Model.RoundNumber / @Model.TotalRounds</span>
        <h1 style="margin-top:1.1rem">Mål: <span class="mer">@Model.Target</span></h1>
        <p class="answer">Ett sätt: <span class="mer">@Model.SampleSolution</span></p>
    </div>

    <div class="card">
        <table class="scoreboard">
            <thead>
                <tr><th class="who">Spelare</th><th>Nådde</th><th>Poäng</th><th class="total">Total</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td class="who">@r.Name@(r.IsHost ? " (värd)" : "")@(r.IsYou ? " · du" : "")</td>
                        <td class="round" data-label="Nådde">@r.Reached@(r.Missed ? (MarkupString)" <span class=\"mark bad\">✗</span>" : (MarkupString)"")</td>
                        <td class="round" data-label="Poäng">@r.RoundScore</td>
                        <td class="total">@r.TotalSoFar</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.ViewerIsHost)
    {
        <form hx-post="@($"/tank-till-tusen/{Model.JoinCode:N}/next")" hx-target="#screen" hx-swap="innerHTML">
            <input type="hidden" name="__RequestVerificationToken" value="@Model.AntiforgeryToken" />
            <button type="submit" class="btn">@(Model.HasNextPuzzle ? "Nästa pussel" : "Visa slutställning")</button>
        </form>
    }
    else
    {
        <p class="muted center">Väntar på att värden går vidare…</p>
    }
</div>

@code {
    [Parameter] public required TankRoundResultsVm Model { get; set; }
    private string StatePath => $"/tank-till-tusen/{Model.JoinCode:N}/state";
}
