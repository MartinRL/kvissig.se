@* GET /tank-till-tusen/new — the host enters their name before the game is created. Posting
   creates the game (OpenLobby via POST /tank-till-tusen) and the server HX-Redirects to the
   game shell. Full page. *@
<MainLayout Title="Tänk Till Tusen: Skapa spel">
    <div class="wrap">
        <div class="brand">
            <div class="logo"><span class="mer">Tänk Till</span> <span class="mindre">Tusen</span></div>
            <span class="pill soft">Värd</span>
        </div>

        <div class="card">
            <h1>Skapa spel</h1>
            <p class="sub">Nå målet med de fyra räknesätten. Nivå: @Model.Difficulty.</p>

            <form hx-post="/tank-till-tusen" hx-swap="none">
                <input type="hidden" name="__RequestVerificationToken" value="@Model.AntiforgeryToken" />
                <input type="hidden" name="difficulty" value="@Model.Difficulty" />
                <label for="name">Ditt namn</label>
                <input type="text" id="name" name="hostName" placeholder="Skriv ditt namn" autofocus required />
                <label for="roundCount">Antal pussel: <span id="roundCountVal">@DefaultRoundCount</span></label>
                <div class="diffwrap">
                    <input type="range" id="roundCount" name="roundCount"
                           min="@MinRoundCount" max="@MaxRoundCount" step="1" value="@DefaultRoundCount"
                           aria-label="Antal pussel" />
                </div>
                <button type="submit" class="btn">Skapa spel</button>
            </form>
        </div>
    </div>

    <script>
        (function () {
            const range = document.getElementById('roundCount');
            const val = document.getElementById('roundCountVal');
            const min = Number(range.min), max = Number(range.max);
            function render() {
                const v = Number(range.value);
                val.textContent = v;
                const n = Math.round((v - min) / (max - min) * 100);
                range.style.background = `linear-gradient(90deg, var(--accent) ${n}%, var(--line) ${n}%)`;
                range.setAttribute('aria-valuetext', `${v} pussel`);
            }
            range.addEventListener('input', render);
            render();
        })();
    </script>
</MainLayout>

@code {
    [Parameter] public required TankHostFormVm Model { get; set; }

    private static int DefaultRoundCount => global::TankTillTusen.Domain.Decider.DefaultRoundCount;
    private static int MinRoundCount => global::TankTillTusen.Domain.Decider.MinRoundCount;
    private static int MaxRoundCount => global::TankTillTusen.Domain.Decider.MaxRoundCount;
}
