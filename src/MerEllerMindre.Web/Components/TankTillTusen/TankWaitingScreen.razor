@* After a player locks a solution: it is submitted and they wait. Polls every 2 s so the
   reveal appears automatically once the score gear fires (all solutions in OR deadline passed). *@
<div hx-get="@StatePath" hx-trigger="every 2s" hx-target="#screen" hx-swap="innerHTML">
    <div class="card center">
        <span class="pill">Pussel @Model.RoundNumber / @Model.TotalRounds</span>
        <h1 style="margin-top:1.1rem">Ditt svar är låst ✓</h1>
        <p class="busy">@Model.DoneCount av @Model.TotalCount klara</p>
    </div>

    @if (Model.Done.Count > 0)
    {
        <div class="card">
            <div class="cardhead">Klara</div>
            <ul class="players">
                @foreach (var p in Model.Done)
                {
                    <li><span class="dot"></span><span class="who">@p.Name</span><span class="tag">@(p.IsYou ? "du · klar" : "klar")</span></li>
                }
            </ul>
        </div>
    }

    @if (Model.Pending.Count > 0)
    {
        <div class="card">
            <div class="cardhead">Väntar på</div>
            <ul class="players">
                @foreach (var p in Model.Pending)
                {
                    <li><span class="dot pending"></span><span class="who">@p.Name</span><span class="tag">räknar…</span></li>
                }
            </ul>
        </div>
    }
</div>

@code {
    [Parameter] public required TankWaitingVm Model { get; set; }
    private string StatePath => $"/tank-till-tusen/{Model.JoinCode:N}/state";
}
