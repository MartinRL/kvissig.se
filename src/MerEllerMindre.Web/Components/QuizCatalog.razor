@* GET / — the Quiz Catalog. The GM picks a pack; "Spela" links to /games/new/{packId} where
   the host enters their name before the game is created. Full page (wraps MainLayout). *@
<MainLayout Title="Mer eller Mindre — välj kviss och spela"
            Description="Mer eller Mindre (eng. More or Less) — det svenska frågespelet online men tillsammans i samma rum. Välj ett frågepaket, samla gänget runt bordet och spela på var sin skärm. Läs mer på Om spelet."
            CanonicalPath="/">
    <div class="wrap">
        <div class="brand">
            <div class="logo"><span class="mer">Mer</span> eller <span class="mindre">Mindre</span></div>
            <span class="pill soft">Spelledare</span>
        </div>

        <h1>Välj kviss</h1>
        <p class="sub">Ett frågepaket motsvarar en kortlek. Du blir värd och första spelaren.</p>

        @foreach (var pack in Model.Packs)
        {
            <div class="card">
                <div class="pack">
                    <div class="info">
                        <div class="name">@pack.Name</div>
                        <div class="count">@Decider.QuestionsPerGame frågor per omgång · @pack.QuestionCount kort i leken</div>
                    </div>
                    <a class="btn" href="/games/new/@pack.PackId">Spela</a>
                </div>
            </div>
        }
    </div>
</MainLayout>

@code {
    [Parameter] public required CatalogVm Model { get; set; }
}
