@* GET / — the Quiz Catalog. The host picks a pack; "Spela" links to /games/new/{packId} where
   the host enters their name before the game is created. Full page (wraps MainLayout). *@
<MainLayout Title="Mer eller Mindre: gissa mer/mindre och hur stor skillnaden är"
            Description="Gissa mer eller mindre, och sedan hur stor skillnaden är. Mer eller Mindre (eng. More or Less) är frågespelet ni spelar online men tillsammans i samma rum, var och en på sin skärm. Välj ett frågepaket och samla gänget runt bordet."
            CanonicalPath="/">
    <div class="wrap">
        <div class="brand">
            <div class="logo"><span class="mer">Mer</span> eller <span class="mindre">Mindre</span></div>
            <ShareButton />
            <span class="pill soft">Värd</span>
        </div>

        <p class="sub">Vill ni hellre spela ett snabbt sifferspel? Prova <a href="/tank-till-tusen">Tänk Till Tusen →</a></p>

        <h1>Välj Mer eller Mindre-kviss</h1>
        <p class="sub">Ett frågepaket motsvarar en kortlek. Du blir värd och första spelaren.</p>

        @foreach (var pack in Model.Packs)
        {
            <div class="card@(pack.IsNew ? " is-new" : "")">
                <div class="pack">
                    <div class="info">
                        <div class="name">@pack.Name @if (pack.IsNew) { <span class="pill new">Nytt</span> }</div>
                        <div class="count">@(pack.PackId.Contains("mini") ? Decider.MiniGameSize : Decider.FullGameSize) frågor per omgång · @pack.QuestionCount kort i leken</div>
                    </div>
                    <a class="btn" href="/games/new/@pack.PackId">Spela</a>
                </div>
            </div>
        }

        <div class="card">
            <div class="pack">
                <div class="info">
                    <div class="name">Tänk Till Tusen</div>
                    <div class="count">Sifferspelet: sex tal, ett mål, en minut</div>
                </div>
                <a class="btn" href="/tank-till-tusen">Spela</a>
            </div>
        </div>
    </div>
</MainLayout>

@code {
    [Parameter] public required CatalogVm Model { get; set; }
}
