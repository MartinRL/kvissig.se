<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- The Quiz catalog (question packs) is domain reference data. Copy the CSVs to
       output so referencing projects (Web, Tests) find them beside the assembly. -->
  <ItemGroup>
    <Content Include="data\**\*.csv" CopyToOutputDirectory="PreserveNewest" />
    <!-- Logo corpus PNGs for the loggor-* packs: copied to output so Web serves them at /logos. -->
    <Content Include="data\logos\**\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Stratum-1 records (Commands/Events/Errors + unions) are BUILD ARTIFACTS generated
       from the emlang spec into obj/ — they are deliberately NOT on disk (ADR 016). -->
  <ItemGroup>
    <AdditionalFiles Include="..\..\specs\mer-eller-mindre.em.yaml" EmlangPrefix="Game" />
    <PackageReference Include="Emlang.Generators" Version="0.1.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
