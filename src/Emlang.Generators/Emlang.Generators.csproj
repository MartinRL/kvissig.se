<Project Sdk="Microsoft.NET.Sdk">

  <!-- kvissig's own emlang source generators (extracted from the xmlang repo on 2026-09-14:
       generators are per application, the DSL repo holds only the two DSLs). CodeGen/ maps a
       *.em.yaml spec onto THIS app's conventions: Prefix+Command/Event/Error unions,
       Prefix+State/Context, Decider.Evolve/Decide partials, Fixtures.* test values,
       Projections.X. Consumed by the Domain projects via ProjectReference as an analyzer. -->
  <PropertyGroup>
    <!-- Analyzers run inside the compiler process: netstandard2.0, old-stable Roslyn —
         CS9057 fires only when the analyzer's Roslyn is NEWER than the compiler's,
         so old is the safe direction under a preview SDK. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IsPackable>false</IsPackable>
    <RootNamespace>Emlang.Generators</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" GeneratePathProperty="true" PrivateAssets="all" />
  </ItemGroup>

  <!-- Roslyn-cookbook dependency shipping for ProjectReference consumers: every
       TargetPathWithTargetPlatformMoniker returned from GetTargetPath becomes an Analyzer
       item in the consuming project, so YamlDotNet loads beside the generator. -->
  <PropertyGroup>
    <GetTargetPathDependsOn>$(GetTargetPathDependsOn);GetDependencyTargetPaths</GetTargetPathDependsOn>
  </PropertyGroup>
  <Target Name="GetDependencyTargetPaths">
    <ItemGroup>
      <TargetPathWithTargetPlatformMoniker Include="$(PKGYamlDotNet)\lib\netstandard2.0\YamlDotNet.dll" IncludeRuntimeDependency="false" />
    </ItemGroup>
  </Target>

</Project>
