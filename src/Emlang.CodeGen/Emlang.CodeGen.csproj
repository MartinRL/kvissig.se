<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Analyzer host requirement: Emlang.Generators loads this dll inside the compiler
         process, which is netstandard2.0 territory (ADR 016). Overrides the repo-wide
         net11.0 from Directory.Build.props; LangVersion preview is inherited. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

</Project>
