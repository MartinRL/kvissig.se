{
  "enabledPlugins": {
    "ralph-loop@claude-plugins-official": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "if grep -qE '(mer-eller-mindre|blindbudet)\\.em\\.yaml'; then export PATH=\"$PATH:/c/Program Files/Go/bin:$HOME/go/bin\"; emlang diagram specs/mer-eller-mindre.em.yaml -o specs/mer-eller-mindre.em.html; emlang diagram specs/blindbudet.em.yaml -o specs/blindbudet.em.html; fi 2>/dev/null || true",
            "statusMessage": "Regenerating event-model diagrams"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/arch-fitness.sh\"",
            "statusMessage": "Checking architecture fitness"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/codehealth.sh\" --changed",
            "statusMessage": "Checking code health (CH >= 9.4)"
          }
        ]
      }
    ]
  }
}
