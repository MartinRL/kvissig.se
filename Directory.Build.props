<Project>
  <PropertyGroup>
    <!-- Override non-standard Platform values from environment (e.g., "windows" from MAUI) -->
    <Platform Condition="'$(Platform)' != 'AnyCPU' and '$(Platform)' != 'x64' and '$(Platform)' != 'x86' and '$(Platform)' != 'ARM64'">AnyCPU</Platform>
  </PropertyGroup>

  <PropertyGroup>
    <!-- C# 15 union types ship with .NET 11 / LangVersion preview (see ADR 006) -->
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <!-- Makes the spec wiring visible to src/Emlang.Generators:
         <AdditionalFiles Include="specs/my-game.em.yaml" EmlangPrefix="Game" />
       optional per-file EmlangNamespace override (default: RootNamespace), and the
       project-level EmlangEmit gate (absent = "surface", tests projects set "tests"). -->
  <ItemGroup>
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="EmlangPrefix" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="EmlangNamespace" />
    <CompilerVisibleProperty Include="EmlangEmit" />
    <CompilerVisibleProperty Include="RootNamespace" />
  </ItemGroup>
</Project>
